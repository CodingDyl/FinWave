#   "failure_message": null,
#   "created_at": "2025-01-11T10:00:00Z",
#   "idempotency_key": "unique-key-123"
# }

### Variables (set these in your environment or replace manually):
# @beneficiaryId = beneficiary-uuid-here
# @destinationId = destination-uuid-here
# @payoutId = payout-uuid-here
# @idempotencyKey = unique-idempotency-key-123